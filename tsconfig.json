{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@zivvvo/content": ["packages/content/src/index.ts"],
      "@zivvvo/learning-engine": ["packages/learning-engine/src/index.ts"],
      "@zivvvo/assessment-engine": ["packages/assessment-engine/src/index.ts"],
      "@zivvvo/ai-gateway": ["packages/ai-gateway/src/index.ts"],
      "@zivvvo/ai-tutor-language": ["packages/ai-tutor-language/src/index.ts"]
    }
  },
  "include": ["apps/web/src", "packages/*/src"],
  "exclude": ["node_modules", "dist"]
}